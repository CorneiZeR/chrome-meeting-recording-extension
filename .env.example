# NOTHING HERE IS NEEDED FOR A CHROME BUILD. Chrome signs in to Drive natively
# (chrome.identity.getAuthToken, ADR-0002) with the public client id committed in
# static/manifest.json.

# Optional: overrides that committed Chrome-extension client id, for a build that
# needs a different one. Must be an OAuth client of type "Chrome Extension"
# created for this extension's id.
# GOOGLE_OAUTH_CLIENT_ID=your-chrome-extension-client-id.apps.googleusercontent.com

# Required only to connect Drive on the non-Chrome targets (Edge, Brave, Opera,
# Vivaldi, Arc), which use chrome.identity.launchWebAuthFlow. Create a "Web
# application" OAuth client and register the redirect URI printed by
# `npm run redirect-uri` on it. Without these, those builds cannot connect Drive;
# every other feature works.
GOOGLE_WEB_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_OAUTH_CLIENT_SECRET=your-web-client-secret

# Required for production builds. Must be the exact HTTPS Worker ingestion route.
TELEMETRY_ENDPOINT=https://recording-extension-telemetry.kstroevsky.workers.dev/api/telemetry/batches
